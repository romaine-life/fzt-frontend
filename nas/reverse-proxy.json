{
  "description": "fzt-frontend",
  "proxy_connect_timeout": 60,
  "proxy_read_timeout": 300,
  "proxy_send_timeout": 300,
  "proxy_http_version": 1,
  "proxy_intercept_errors": false,
  "frontend": {
    "acl": null,
    "fqdn": "fzt-frontend.home.romaine.life",
    "port": 443,
    "protocol": 1,
    "https": {
      "hsts": true
    }
  },
  "backend": {
    "fqdn": "localhost",
    "port": 3020,
    "protocol": 0
  },
  "customize_headers": [
    {
      "name": "X-Forwarded-Proto",
      "value": "https"
    }
  ]
}
