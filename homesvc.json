{
  "templates": [
    {
      "owner": "1001:1001",
      "from": "nas/store-deploy-key.template",
      "mode": "0400",
      "restart": "fzt-frontend",
      "to": "credentials/store-deploy-key"
    }
  ],
  "host": {
    "proxies": [
      "nas/reverse-proxy.json"
    ],
    "name": "fzt-frontend.home.romaine.life"
  },
  "dirs": [
    {
      "owner": "1001:1001",
      "path": "credentials",
      "mode": "0700"
    }
  ],
  "name": "fzt-frontend",
  "secrets": [
    {
      "existing": true,
      "name": "store-deploy-key"
    },
    {
      "name": "registry-read-token",
      "existing": true
    }
  ],
  "health": {
    "title": "Tree store",
    "down": "Menu sync, menu edits and homepage bookmarks cannot reach the tree store.",
    "url": "https://fzt-frontend.home.romaine.life/health"
  },
  "homepage": {
    "name": "Tree store",
    "description": "Menu and bookmark API on the NAS; auth.romaine.life JWTs are required for trees.",
    "url": "https://fzt-frontend.home.romaine.life/health"
  },
  "files": [
    "nas/docker-compose.yml"
  ],
  "registry": {
    "username": "nelson",
    "server": "forgejo.romaine.life",
    "passwordSecret": "registry-read-token"
  }
}
